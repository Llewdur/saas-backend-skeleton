<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!-- Framework glue with no logic of our own. Service providers
                 register bindings + Gates; testing them is testing Laravel. -->
            <file>app/Providers/AppServiceProvider.php</file>
            <file>app/Providers/HorizonServiceProvider.php</file>
            <file>app/Support/ModuleServiceProvider.php</file>
            <file>app/Modules/Audit/AuditModuleServiceProvider.php</file>
            <file>app/Modules/Auth/AuthModuleServiceProvider.php</file>
            <file>app/Modules/Billing/BillingModuleServiceProvider.php</file>
            <file>app/Modules/Core/CoreModuleServiceProvider.php</file>
            <file>app/Modules/Integrations/IntegrationsModuleServiceProvider.php</file>
            <file>app/Modules/Tenant/TenantModuleServiceProvider.php</file>
            <file>app/Modules/Users/UsersModuleServiceProvider.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
